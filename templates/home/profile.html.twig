{% extends 'base.html.twig' %}

{% block title %}
    Mon profil
{% endblock %}

{% block body %}

    <h1>Mon profil</h1>

    <p>Nom : {{ nom }}</p>
    <p>Prénom : {{ prenom }}</p>
    <p>Formation : {{ formation }}</p>
    <p>Âge : {{ age }}</p>
    <p>Ville : {{ ville }}</p>

    {% if age >= 18 %}
        <p>Tu es majeur.</p>
    {% else %}
        <p>Tu es mineur.</p>
    {% endif %}

    <h2>Mes compétences</h2>

    <ul>
        {% for competence in competences %}
            <li>{{ competence }}</li>
        {% endfor %}
    </ul>

{% endblock %}



