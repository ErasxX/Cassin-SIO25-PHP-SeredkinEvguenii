<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Mon site Symfony{% endblock %}</title>

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
</head>

<body>

    <nav>
        <a href="{{ path('app_home') }}">Accueil</a>
        <a href="{{ path('app_about') }}">À propos</a>
        <a href="{{ path('app_profile') }}">Profil</a>
        <a href="{{ path('app_number') }}">Nombre aléatoire</a>
        <a href="{{ path('app_membres') }}">Membres</a>

    </nav>

    <hr>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <main>
        {% block body %}{% endblock %}
    </main>

</body>
</html>
