{% extends 'base.html.twig' %}

{% block title %}Club{% endblock %}

{% block body %}
    <h1>Club</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ club.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ club.nom }}</td>
            </tr>
        </tbody>
    </table>

    <h2>Membres du club</h2>

    <ul>
        {% for membre in club.membres %}
            <li>
                {{ membre.prenom }} {{ membre.nom }}
                — {{ membre.email }}
            </li>
        {% else %}
            <li>Aucun membre dans ce club.</li>
        {% endfor %}
    </ul>

    <a href="{{ path('app_club_index') }}">back to list</a>

    <a href="{{ path('app_club_edit', {'id': club.id}) }}">edit</a>

    {{ include('club/_delete_form.html.twig') }}
{% endblock %}
