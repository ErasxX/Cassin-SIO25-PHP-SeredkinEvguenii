{% extends 'base.html.twig' %}

{% block title %}
    Modifier un membre
{% endblock %}

{% block body %}

    <h1>Modifier le membre</h1>

    {{ form_start(form) }}

        {{ form_row(form.nom) }}
        {{ form_row(form.prenom) }}
        {{ form_row(form.email) }}

        <button type="submit">Enregistrer les modifications</button>

    {{ form_end(form) }}

{% endblock %}
